AGENT_SERVER_URL=http://127.0.0.1:8080
AGENT_WS_PROXY_URL=wss://ai.vituralmodel.com
NEXT_PUBLIC_HEAD_MOTION_ENABLED=true
NEXT_PUBLIC_HEAD_MOTION_ENDPOINT=http://127.0.0.1:8787

# Optional Trulience avatar integration. Keep real values in .env.local.
NEXT_PUBLIC_TRULIENCE_AVATAR_ID=4999232223300240556
NEXT_PUBLIC_TRULIENCE_TOKEN=
TRULIENCE_API_KEY=

# Optional local/cloud worker for user-photo -> Live2D Cubism model generation.
# Local worker: http://127.0.0.1:8790/live2d/generate
LIVE2D_GENERATOR_ENDPOINT=http://127.0.0.1:8790/live2d/generate
LIVE2D_GENERATOR_API_KEY=
LIVE2D_GENERATOR_CALLBACK_URL=
LIVE2D_GENERATOR_CALLBACK_TOKEN=

# Optional local GPU digital-human worker.
GPU_AVATAR_ENDPOINT=http://127.0.0.1:8810
GPU_AVATAR_ALLOW_REMOTE=false
GPU_AVATAR_RENDER_TIMEOUT_MS=180000
