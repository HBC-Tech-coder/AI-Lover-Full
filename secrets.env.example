# Copy this file to secrets.env and fill real values locally or on the server.
# Never commit secrets.env.

# TEN speech/chat runtime
ALIYUN_ASR_API_KEY=
SPEECHMATICS_API_KEY=
SPEECHMATICS_LANGUAGE=cmn
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_PROXY_URL=

# ASR/TTS providers. Fill only the providers you use.
DEEPGRAM_API_KEY=
AZURE_TTS_API_KEY=
# Azure Speech requires the region that owns the key, for example eastasia.
AZURE_TTS_REGION=
ELEVENLABS_TTS_KEY=
MINIMAX_TTS_API_KEY=
MINIMAX_TTS_GROUP_ID=
# Legacy MiniMax aliases kept for older local scripts.
MINIMAX_TTS_KEY=
MINIMAX_GROUP_ID=

# Realtime/channel services
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Message bots and tool MCP servers
DINGTALK_BOT_ACCESS_TOKEN=
DINGTALK_BOT_SECRET=
BOCHA_API_KEY=
BAIDU_MAP_AK=
QWEATHER_HOST=
QWEATHER_KEY=
WECOM_WEBHOOK_KEY=
LARK_APP_ID=
LARK_APP_SECRET=

# Frontend/admin/API integrations
ADMIN_TOKEN=
LLM_GATEWAY_KEY=
LLM_GATEWAY_URL=
LLM_ANALYSIS_MODEL=
TRULIENCE_API_KEY=
HEYGEN_LIVEAVATAR_API_KEY=
LIVEAVATAR_API_KEY=
HEYGEN_API_KEY=

# Live2D generation worker / cloud rigging provider
LIVE2D_GENERATOR_API_KEY=
LIVE2D_GENERATOR_CALLBACK_TOKEN=
LIVE2D_RIGGING_API_KEY=

# GPU digital human worker. Keep local/private LAN by default.
GPU_AVATAR_ENDPOINT=http://127.0.0.1:8810
GPU_AVATAR_ALLOW_REMOTE=false
GPU_AVATAR_RENDER_TIMEOUT_MS=180000

# Optional hardware defaults
HEAD_MOTION_ADB_SERIAL=
HEAD_MOTION_ADB_PATH=
